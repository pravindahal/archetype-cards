#!/usr/bin/env bash
# generate-card <arch_num>
# Generates a card image for the given archetype number.
# Usage: ./generate-card 2

set -euo pipefail

ARCHETYPES_DIR="$(cd "$(dirname "$0")/archetypes" && pwd)"
GENERATE_SCRIPT="$(cd "$(dirname "$0")" && pwd)/archetype_cards/generate_cards.py"

# ── Validate input ──────────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <arch_num>"
  echo "  arch_num: 1-32 (the archetype number to generate)"
  exit 1
fi

ARCH_NUM="$1"

# ── Find the matching archetype file ────────────────────────────────────────
# Files are named like: 01_Visionary_OCEAN.md, 02_Architect_OCEAn.md, etc.
PADDED=$(printf "%02d" "$ARCH_NUM")
ARCH_FILE=$(find "$ARCHETYPES_DIR" -maxdepth 1 -name "${PADDED}_*.md" | sort | head -1)

if [[ -z "$ARCH_FILE" ]]; then
  echo "Error: No archetype file found for number $ARCH_NUM (looked for ${PADDED}_*.md in $ARCHETYPES_DIR)"
  exit 1
fi

echo "Found: $ARCH_FILE"

# ── Extract the Visual Concept line ────────────────────────────────────────
# Matches: "- **Visual Concept:** <text>"
VISUAL_CONCEPT=$(sed -n 's/.*\*\*Visual Concept:\*\* //p' "$ARCH_FILE" | head -1)

if [[ -z "$VISUAL_CONCEPT" ]]; then
  echo "Error: Could not find '**Visual Concept:**' in $ARCH_FILE"
  exit 1
fi

echo "Visual Concept: $VISUAL_CONCEPT"

# ── Derive output filename from md filename (without extension) ─────────────
MD_BASENAME=$(basename "$ARCH_FILE" .md)
OUTPUT_FILENAME="${MD_BASENAME}.png"

echo "Output: card_art/$OUTPUT_FILENAME"
echo ""

# ── Run the generator ───────────────────────────────────────────────────────
python -m uv run "$GENERATE_SCRIPT" \
  --description "$VISUAL_CONCEPT" \
  --output "$OUTPUT_FILENAME"
